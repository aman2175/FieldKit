# Fieldkit — tenancy + RLS slice

# 1) Start infra (Postgres + Redis from compose.yml)
docker compose up -d
  # Starts:
  # - fieldkit-postgres-1 (Postgres 16 on localhost:5432)
  # - fieldkit-redis-1 (Redis 7 on localhost:6379)

# 2) Create Alembic scaffolding
source .venv/bin/activate
alembic init alembic
  # Creates:
  # - alembic.ini (config, DB URL)
  # - alembic/env.py, script.py.mako, README
  # - alembic/versions/ (empty folder for migrations)

# 3) Point Alembic at local Postgres
# (edited in alembic.ini)
sqlalchemy.url = postgresql+psycopg://fieldkit:fieldkit@localhost:5432/fieldkit
  # Connect as user=fieldkit, password=fieldkit, db=fieldkit on localhost:5432

# 4) Create first migration file
alembic revision -m "create jobs with tenant rls"
  # Generated: alembic/versions/67d09138198a_create_jobs_with_tenant_rls.py

# 5) (Because Alembic login from host kept failing) Apply migration SQL manually inside the container

# 5a) Open psql inside container as fieldkit
docker exec -it fieldkit-postgres-1 psql -U fieldkit
  # psql prompt: fieldkit=#

# 5b) Run the schema + RLS setup once (copied from the migration)
-- 1) jobs table: one row per job, with tenant_id on every row
CREATE TABLE IF NOT EXISTS jobs (
    id        uuid PRIMARY KEY,
    tenant_id uuid NOT NULL,
    title     text NOT NULL
);

-- 2) enable and force RLS on jobs
ALTER TABLE jobs ENABLE ROW LEVEL SECURITY;
ALTER TABLE jobs FORCE ROW LEVEL SECURITY;

-- 3) tenant isolation policy
DROP POLICY IF EXISTS jobs_tenant_isolation ON jobs;
CREATE POLICY jobs_tenant_isolation ON jobs
    USING (tenant_id = current_setting('app.tenant_id', true)::uuid)
    WITH CHECK (tenant_id = current_setting('app.tenant_id', true)::uuid);

-- 4) allow the app role to use the table (we are logged in as fieldkit)
GRANT SELECT, INSERT, UPDATE, DELETE ON jobs TO fieldkit;

# Results:
# - jobs table exists with id, tenant_id, title
# - RLS enabled + forced on jobs
# - jobs_tenant_isolation policy installed
# - fieldkit role can SELECT/INSERT/UPDATE/DELETE its own rows on jobs

########################################################


# RLS in simple words

jobs.tenant_id is stored on each job row. It says who owns the job.

app.tenant_id is a temporary note on the connection. It says who is asking right now.

set_config writes that note.
current_setting reads that note.

RLS rule:
show a row only if job.tenant_id equals the note app.tenant_id.

Example:
Note says A.
Job A matches -> show it.
Job B does not match -> hide it.

The note is not saved in the table.
It lasts only for this request.